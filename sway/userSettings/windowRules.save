#GAAAPS
#this shit makes it look SOOOOOOO MUCH PRETTIER!!!!
gaps inner 7
gaps outer 0
corner_radius 5
smart_borders on
smart_gaps on

default_floating_border normal
default_border pixel 3
shadows on

#per app stuffs
#for_window[app_id=""]
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_type="dialog"] floating enable

for_window [app_id="pwvucontrol"] floating enable, resize set 600 px 400 px corner_radius 20
for_window [app_id="blueman-manager"] floating enable
for_window [app_id="pwvucontrol"] floating enable

#basic blur settings, mostly useful for kitty as nothing else has transparency rn.
blur enable
blur_passes 3
blur_radius 5
blur_contrast 1.3
blur_saturation 1
default_dim_inactive 0.2

for_window [all] opacity 0.98

#borders
set $pure_black   #252525
set $deep_red     #f3008e 
set $miku_teal    #39C5BB  
set $miku_white   #FFFFFF

# class                 border        background    text         indicator     child_border
client.focused          $miku_teal    $pure_black   $miku_white  $deep_red     $miku_teal
client.focused_inactive $deep_red     $pure_black   $miku_teal   $pure_black   $deep_red
client.unfocused        $pure_black   $pure_black   $deep_red    $pure_black   $pure_black
client.urgent           $deep_red     $deep_red     $miku_white  $miku_teal    $deep_red

