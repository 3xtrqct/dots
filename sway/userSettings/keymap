input "type:keyboard" {
    #need both because it toggles
    xkb_layout us,us
    #I guess that just leaving it blank gives it as no variant
    
    xkb_variant colemak
    
    #you can add tons more here
    #if you want to add more here are man pages
    #this one sucks ass but does kinda help 'man 5 sway-input'
    #this one is the one I reccomend 'man 7 xkeyboard-config'

    xkb_options grp:shift_caps_toggle,caps:backspace
    #this might be too fast so maybe change it when you need to
    repeat_delay 140
    repeat_rate 30
}

